{
  "name": "tonatools",
  "displayName": "tonatools",
  "publisher": "tonadev",
  "description": "Fast palette commands for the typing developer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tona-dev/tonatools.git"
  },
  "bugs": {
    "url": "https://github.com/tona-dev/tonatools/issues"
  },
  "homepage": "https://github.com/tona-dev/tonatools#readme",
  "version": "0.4.0",
  "icon": "images/logo-256x256.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tonatools.filesystem.cfn",
        "title": "Copy file name",
        "category": "File"
      },
      {
        "command": "tonatools.filesystem.cfd",
        "title": "Copy current workspace directory",
        "category": "File"
      },
      {
        "command": "tonatools.git.copyremoteurl",
        "title": "Copy file location in remote url",
        "category": "Git"
      },
      {
        "command": "tonatools.open.projectdirectory",
        "title": "Project directory",
        "category": "Open"
      },
      {
        "command": "tonatools.open.filedirectory",
        "title": "File directory",
        "category": "Open"
      },
      {
        "command": "tonatools.search.indirectory",
        "title": "In directory",
        "category": "Search"
      }
    ],
    "configuration": {
      "title": "tonatools",
      "properties": {
        "tonatools.git.remoteTemplates": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "markdownDescription": "URL of a file. Placeholders: `${host}`, `${path}` (e.g. `owner/repo`), `${branch}`, `${file}`."
              },
              "line": {
                "type": "string",
                "markdownDescription": "Anchor for a single line. Placeholder: `${start}`."
              },
              "lineRange": {
                "type": "string",
                "markdownDescription": "Anchor for a range of lines. Placeholders: `${start}`, `${end}`."
              }
            },
            "additionalProperties": false
          },
          "markdownDescription": "URL templates per git remote host, used by `Git: Copy file location in remote url`.\n\n`github.com`, `gitlab.com` and `bitbucket.org` are built in. Keys you leave out fall back individually, most specific first: your entry for the host, then the built-in for that host, then your `*` entry, then the default — so you only write the keys that differ. Use `*` as the host to override the fallback for unrecognised hosts.\n\n```json\n{\n  \"git.example.com\": {\n    \"file\": \"https://${host}/${path}/-/blob/${branch}/${file}\",\n    \"line\": \"#L${start}\",\n    \"lineRange\": \"#L${start}-${end}\"\n  }\n}\n```"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run typecheck:scripts && pnpm run lint",
    "typecheck:scripts": "tsc -p scripts",
    "lint": "eslint src scripts",
    "test": "vscode-test",
    "release": "node scripts/release.mts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "bumpy": {
    "skipNpmPublish": true
  },
  "dependencies": {
    "@varlock/bumpy": "^1.18.1"
  }
}
